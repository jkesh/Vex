{
  "name": "vex-agent-cli",
  "version": "0.9.1",
  "description": "Independent adaptive chat, code review, and multi-agent engineering CLI",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jkesh/Vex.git"
  },
  "homepage": "https://github.com/jkesh/Vex#readme",
  "bugs": {
    "url": "https://github.com/jkesh/Vex/issues"
  },
  "keywords": [
    "cli",
    "terminal-ui",
    "coding-agent",
    "multi-agent",
    "worktree",
    "rag"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./knowledge": "./dist/knowledge.js"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "vex": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "roles",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "setup": "npm install && npm run build && npm link",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "undici": "^7.29.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.3.14"
}
